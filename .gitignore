# ============================================================
# Project Redoubt .gitignore
# ============================================================

# Secrets and environment files
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.crt.private

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.example.tfvars

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Keep Terraform dependency lock file
!.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Operating systems
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Raw security-lab evidence
evidence/raw/

# Local secrets / credentials
credentials/
secrets/
private/

# Project Redoubt runtime lab evidence
evidence/runtime/
lab/.env
