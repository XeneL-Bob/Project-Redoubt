{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "DET-001",
      "title": "Restricted Finance Resource Access Denied",
      "description": "Authenticated subject denied access to the restricted Finance API.",
      "kind": "match",
      "severity": "medium",
      "match": {
        "source": "gateway",
        "event_type": "policy_decision",
        "outcome": "deny",
        "resource": "finance-api"
      },
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-001",
        "R-005"
      ]
    },
    {
      "id": "DET-002",
      "title": "Finance Access Attempt from Untrusted Device",
      "description": "Finance access denied because the device is not trusted.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": "gateway",
        "event_type": "policy_decision",
        "outcome": "deny",
        "resource": "finance-api",
        "details.device_trusted": false
      },
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-001",
        "R-005"
      ]
    },
    {
      "id": "DET-003",
      "title": "Repeated Authorisation Denials",
      "description": "Three denied policy decisions for the same subject within sixty seconds.",
      "kind": "threshold",
      "severity": "high",
      "match": {
        "source": "gateway",
        "event_type": "policy_decision",
        "outcome": "deny"
      },
      "group_by": "subject",
      "threshold": 3,
      "window_seconds": 60,
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-001",
        "R-003"
      ]
    },
    {
      "id": "DET-004",
      "title": "Finance Application Policy Bypass",
      "description": "Successful Finance application access without a correlated gateway ALLOW.",
      "kind": "missing_prior",
      "severity": "critical",
      "match": {
        "source": "finance-api",
        "event_type": "application_access",
        "outcome": "allow",
        "resource": "finance-api"
      },
      "prior_match": {
        "source": "gateway",
        "event_type": "policy_decision",
        "outcome": "allow",
        "resource": "finance-api"
      },
      "correlation_field": "correlation_id",
      "within_seconds": 30,
      "attack_techniques": [],
      "risk_ids": [
        "R-004",
        "R-011"
      ]
    },
    {
      "id": "DET-005",
      "title": "Secret Access Without Policy Authorisation",
      "description": "Finance secret retrieval without a correlated gateway ALLOW.",
      "kind": "missing_prior",
      "severity": "critical",
      "match": {
        "source": "finance-api",
        "event_type": "vault_secret_access",
        "outcome": "allow",
        "resource": "finance-api"
      },
      "prior_match": {
        "source": "gateway",
        "event_type": "policy_decision",
        "outcome": "allow",
        "resource": "finance-api"
      },
      "correlation_field": "correlation_id",
      "within_seconds": 30,
      "attack_techniques": [],
      "risk_ids": [
        "R-007",
        "R-011"
      ]
    },
    {
      "id": "DET-006",
      "title": "Direct Backend Access Attempt",
      "description": "Attempt to access a protected workload without the expected gateway credential.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": [
          "employee-api",
          "finance-api"
        ],
        "event_type": "direct_backend_access_denied",
        "outcome": "deny"
      },
      "attack_techniques": [],
      "risk_ids": [
        "R-003",
        "R-011"
      ]
    },
    {
      "id": "DET-007",
      "title": "Privileged Elevation Denied",
      "description": "An identity was denied JIT privileged elevation.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": "privilege-broker",
        "event_type": "privileged_elevation",
        "outcome": "deny"
      },
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-002",
        "R-008"
      ]
    },
    {
      "id": "DET-008",
      "title": "Repeated Privileged Elevation Denials",
      "description": "Three denied privileged-elevation attempts for the same subject within sixty seconds.",
      "kind": "threshold",
      "severity": "critical",
      "match": {
        "source": "privilege-broker",
        "event_type": "privileged_elevation",
        "outcome": "deny"
      },
      "group_by": "subject",
      "threshold": 3,
      "window_seconds": 60,
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-002",
        "R-008"
      ]
    },
    {
      "id": "DET-009",
      "title": "Direct Management Backend Access Attempt",
      "description": "A caller attempted to bypass the management PEP using an invalid workload credential.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "management-api",
        "event_type": "direct_management_access_denied",
        "outcome": "deny"
      },
      "attack_techniques": [],
      "risk_ids": [
        "R-002",
        "R-008"
      ]
    },
    {
      "id": "DET-010",
      "title": "Privileged Access from Untrusted Device",
      "description": "A privileged management request was denied because administrative device trust was absent.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": "management-gateway",
        "event_type": "privileged_policy_decision",
        "outcome": "deny",
        "details.admin_device_trusted": false
      },
      "attack_techniques": [
        "T1078"
      ],
      "risk_ids": [
        "R-002",
        "R-008"
      ]
    },
    {
      "id": "DET-011",
      "title": "Security Control Modification",
      "description": "An authorised privileged operation modified security-control configuration.",
      "kind": "match",
      "severity": "medium",
      "match": {
        "source": "management-api",
        "event_type": "privileged_operation",
        "outcome": "allow",
        "resource": "security-management",
        "details.action": "update-detection"
      },
      "attack_techniques": [
        "T1562.001"
      ],
      "risk_ids": [
        "R-008"
      ]
    },
    {
      "id": "DET-012",
      "title": "Management Policy Bypass",
      "description": "A privileged management operation succeeded without a correlated management-gateway ALLOW.",
      "kind": "missing_prior",
      "severity": "critical",
      "match": {
        "source": "management-api",
        "event_type": "privileged_operation",
        "outcome": "allow"
      },
      "prior_match": {
        "source": "management-gateway",
        "event_type": "privileged_policy_decision",
        "outcome": "allow"
      },
      "correlation_field": "correlation_id",
      "within_seconds": 30,
      "attack_techniques": [],
      "risk_ids": [
        "R-002",
        "R-008"
      ]
    },
    {
      "id": "DET-013",
      "title": "Supply Chain Artifact Integrity Failure",
      "description": "A release artifact failed cryptographic digest verification before release.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "release-verifier",
        "event_type": "release_verification",
        "outcome": "deny",
        "details.reason": "artifact_digest_mismatch"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-014",
      "title": "Supply Chain Provenance Signature Failure",
      "description": "Release provenance failed signature verification.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "release-verifier",
        "event_type": "release_verification",
        "outcome": "deny",
        "details.reason": "provenance_signature_invalid"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-015",
      "title": "Untrusted Builder Release Attempt",
      "description": "A release artifact was produced by a builder not trusted by release policy.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "release-verifier",
        "event_type": "release_verification",
        "outcome": "deny",
        "details.reason": "untrusted_builder_identity"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-016",
      "title": "Dirty Source Build Attempt",
      "description": "The trusted builder rejected a build because the source repository was dirty.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": "trusted-builder",
        "event_type": "build_decision",
        "outcome": "deny",
        "details.reason": "dirty_source"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-017",
      "title": "Unsigned Release Attempt",
      "description": "A release verification was attempted without the required signed provenance.",
      "kind": "match",
      "severity": "high",
      "match": {
        "source": "release-verifier",
        "event_type": "release_verification",
        "outcome": "deny",
        "details.reason": "provenance_signature_missing"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-018",
      "title": "Release Without Correlated Trusted Build",
      "description": "A release was accepted without a correlated trusted-builder ALLOW event.",
      "kind": "missing_prior",
      "severity": "critical",
      "match": {
        "source": "release-verifier",
        "event_type": "release_verification",
        "outcome": "allow"
      },
      "prior_match": {
        "source": "trusted-builder",
        "event_type": "build_decision",
        "outcome": "allow"
      },
      "correlation_field": "correlation_id",
      "within_seconds": 120,
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-019",
      "title": "Deployment Approval Denied",
      "description": "The independent release approver rejected a software deployment approval request.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "release-approver",
        "event_type": "deployment_approval",
        "outcome": "deny"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    },
    {
      "id": "DET-020",
      "title": "Deployment Gate Denied",
      "description": "The deployment gate rejected an attempted software deployment.",
      "kind": "match",
      "severity": "critical",
      "match": {
        "source": "deployment-gate",
        "event_type": "deployment_decision",
        "outcome": "deny"
      },
      "attack_techniques": [
        "T1195.002"
      ],
      "risk_ids": [
        "R-006"
      ]
    }
  ]
}
